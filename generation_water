def run(output_dir="CNT_LB_fluid_coupled_final_output", image_filename="CNT_LB_final_512px.png"):
    import time as _time
    _run_wall_start = _time.perf_counter()
    p = P
    out = Path(output_dir)
    out.mkdir(parents=True, exist_ok=True)

    rng = np.random.default_rng(p.seed)

    # 每次运行随机选择 100~150 根 CNT，范围包含端点。
    p.n_rods = int(rng.integers(p.n_rods_min, p.n_rods_max + 1))
    print(f"本次随机 CNT 数量: {p.n_rods}")

    fluid = FluidSolver(p)
    cnt = CNTSystem(p, rng)

    diagnostics = []
    omega_last = np.zeros_like(fluid.u)

    # CNT -> 水反馈已完全关闭，因此覆盖率场不再需要计算。
    coverage = np.zeros_like(fluid.u)
    cnt_force = (
        np.zeros_like(fluid.u),
        np.zeros_like(fluid.v),
    )

    # 显式稳定性检查：扩散和对流的保守上限。
    dt_diff = 0.25 * min(fluid.dx, fluid.dy)**2 / p.nu
    dt_adv = 0.5 * min(fluid.dx, fluid.dy) / max(p.max_fluid_speed, 1e-30)
    dt_limit = min(dt_diff, dt_adv)
    if p.dt > dt_limit:
        print(
            f"WARNING: dt={p.dt:.3e}s > conservative limit "
            f"{dt_limit:.3e}s; reduce Params.dt if instability occurs."
        )

    # 初始化挡板位置。
    fluid.update_barriers(0.0)
    cnt.set_barriers(fluid.barrier_x_left, fluid.barrier_x_right)

    for step in range(p.n_steps):
        sim_time = step * p.dt

        # 1. 流体：完全不接收 CNT -> fluid 反馈。
        fluid.step(cnt_force, coverage, sim_time)

        # 2. CNT：Jeffery + Brownian + 几何接触检测。
        #    CNT-CNT 吸引/排斥/取向相互作用已关闭。
        reaction_on_fluid, omega_last = cnt.update(fluid, p.dt)

        # 3. CNT -> 水反馈全部关闭。
        #    reaction_on_fluid 不再传回流体；CNT 覆盖率也不改变水的表面张力。
        #    因此不再计算无效的 CNT 反馈场，以节省运行时间。
        cnt_force = (
            np.zeros_like(fluid.u),
            np.zeros_like(fluid.v),
        )

        # 4. 诊断。
        if step % p.save_every == 0 or step == p.n_steps - 1:
            d = cnt.diagnostics()
            d.update({
                "step": int(step),
                "time_s": float(sim_time),
                "n_rods": int(cnt.state.n),
                "gap_m": float(
                    fluid.barrier_x_right - fluid.barrier_x_left
                ),
                "max_fluid_speed_m_s": float(
                    np.max(np.hypot(
                        fluid.to_cpu(fluid.u),
                        fluid.to_cpu(fluid.v),
                    ))
                ),
                "mean_abs_vorticity_s-1": float(
                    np.mean(np.abs(omega_last))
                ),
                "max_abs_vorticity_s-1": float(
                    np.max(np.abs(omega_last))
                ),
                "mean_temperature_K": float(np.mean(fluid.T)),
                "max_temperature_K": float(np.max(fluid.T)),
                "min_temperature_K": float(np.min(fluid.T)),
            })
            diagnostics.append(d)
            _elapsed = _time.perf_counter() - _run_wall_start
            _steps_done = step + 1
            _avg_step = _elapsed / max(_steps_done, 1)
            _remaining = _avg_step * max(p.n_steps - _steps_done, 0)
            _elapsed_hms = str(__import__("datetime").timedelta(seconds=int(_elapsed)))
            _remaining_hms = str(__import__("datetime").timedelta(seconds=int(_remaining)))
            print(
                f"step={step:5d}/{p.n_steps} "
                f"gap={d['gap_m']*1e6:7.1f} um "
                f"Sg={d['S_global']:.3f} "
                f"Sl={d['S_local_mean']:.3f} "
                f"|w|max={d['max_abs_vorticity_s-1']:.2f} "
                f"cross={d['intersection_count']} "
                f"已用={_elapsed_hms} 预计剩余={_remaining_hms}"
            )

    # ---------- 最终输出 ----------
    img = render_cnts(cnt, p)
    image_path = out / image_filename
    if cv2 is not None:
        cv2.imwrite(str(image_path), img)
    else:
        from PIL import Image
        Image.fromarray(img).save(image_path)

    _total_elapsed = _time.perf_counter() - _run_wall_start
    _total_hms = str(__import__("datetime").timedelta(seconds=int(_total_elapsed)))
    print("\n" + "=" * 70)
    print(f"模拟完成：实际运行时间 {_total_hms}")
    print(f"最终图片：{image_path}")
    print("=" * 70)

    return out


