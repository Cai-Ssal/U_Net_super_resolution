# 6. 输出
# ============================================================

def render_cnts(cnt: CNTSystem, p: Params):
    """
    超采样渲染 + 最终压缩区裁剪。

    逻辑：
    1. 先以 render_px×render_px（默认 1024×1024）渲染整个计算域；
    2. 根据最终左右挡板位置，只截取两挡板之间的 CNT 膜区域，
       从而彻底去掉挡板运动扫过后的左右黑色空白；
    3. 将这个“最终压缩区”缩放到 output_px×output_px（512×512）保存。

    注意：最终图像代表压缩后的膜区域，而不是整个原始 1 mm×1 mm 计算域。
    不渲染挡板本身。
    """
    big_px = int(max(p.render_px, p.output_px))
    full = np.zeros((big_px, big_px), dtype=np.uint8)
    sx = big_px / p.Lx
    sy = big_px / p.Ly

    for i in range(cnt.state.n):
        a, b = cnt._endpoints(i)
        for shift in (-p.Ly, 0.0, p.Ly):
            aa = a.copy(); bb = b.copy()
            aa[1] += shift; bb[1] += shift
            x1 = int(round(aa[0] * sx))
            y1 = int(round((p.Ly - aa[1]) * sy))
            x2 = int(round(bb[0] * sx))
            y2 = int(round((p.Ly - bb[1]) * sy))

            if cv2 is not None:
                cv2.line(
                    full,
                    (x1, y1), (x2, y2),
                    255, 2,
                    lineType=cv2.LINE_8,
                )
            else:
                npts = max(2, int(np.hypot(x2 - x1, y2 - y1)) + 1)
                xs = np.rint(np.linspace(x1, x2, npts)).astype(int)
                ys = np.rint(np.linspace(y1, y2, npts)).astype(int)
                valid = (
                    (xs >= 0) & (xs < big_px)
                    & (ys >= 0) & (ys < big_px)
                )
                full[ys[valid], xs[valid]] = 255

    # 只保留最终两挡板之间的区域。
    # 使用最终 barrier center，再向内留半个 clearance，避免把挡板位置附近的
    # 数值接触区域误认为黑边。
    left_x = float(cnt.current_barriers[0]) + 0.5 * p.barrier_width
    right_x = float(cnt.current_barriers[1]) - 0.5 * p.barrier_width
    left_px = int(np.ceil(np.clip(left_x * sx, 0, big_px - 1)))
    right_px = int(np.floor(np.clip(right_x * sx, left_px + 1, big_px)))

    cropped = full[:, left_px:right_px]
    if cropped.size == 0 or cropped.shape[1] < 2:
        raise RuntimeError(
            f"最终压缩区裁剪失败：left_px={left_px}, right_px={right_px}, "
            f"full_width={big_px}"
        )

    # 最终强制输出 512×512。INTER_AREA 用于缩小，避免产生明显锯齿。
    if cv2 is not None:
        img = cv2.resize(
            cropped,
            (p.output_px, p.output_px),
            interpolation=cv2.INTER_AREA,
        )
        # 保持最终图像严格二值：CNT=255，背景=0。
        img = np.where(img >= 128, 255, 0).astype(np.uint8)
    else:
        from PIL import Image
        img = np.asarray(
            Image.fromarray(cropped).resize(
                (p.output_px, p.output_px), Image.Resampling.LANCZOS
            )
        )
        img = np.where(img >= 128, 255, 0).astype(np.uint8)

    return img


def save_state(cnt, path):
    arr = np.column_stack((
        cnt.state.x,
        cnt.state.y,
        cnt.state.theta,
        cnt.state.length,
    ))
    np.savetxt(
        path,
        arr,
        delimiter=",",
        header="x_m,y_m,theta_rad,length_m",
        comments="",
    )


def save_json(data, path):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)


