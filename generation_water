def wrap_angle(theta):
    """CNT 无头无尾，因此 theta 与 theta+pi 等价。"""
    return (theta + 0.5 * np.pi) % np.pi - 0.5 * np.pi


def clamp_norm(v: np.ndarray, max_norm: float) -> np.ndarray:
    n = float(np.linalg.norm(v))
    if n > max_norm and n > 0.0:
        return v * (max_norm / n)
    return v


def segment_endpoints(center: np.ndarray, theta: float, length: float):
    p = np.array([math.cos(theta), math.sin(theta)], dtype=float)
    h = 0.5 * length * p
    return center - h, center + h


def point_segment_distance(point, a, b):
    ab = b - a
    den = float(np.dot(ab, ab))
    if den <= 1e-30:
        return float(np.linalg.norm(point - a))
    t = float(np.dot(point - a, ab) / den)
    t = np.clip(t, 0.0, 1.0)
    q = a + t * ab
    return float(np.linalg.norm(point - q))


def closest_points_segments(p1, q1, p2, q2):
    """两条有限二维线段的最近点。"""
    d1 = q1 - p1
    d2 = q2 - p2
    r = p1 - p2
    a = float(np.dot(d1, d1))
    e = float(np.dot(d2, d2))
    f = float(np.dot(d2, r))
    eps = 1e-30

    if a <= eps and e <= eps:
        return p1.copy(), p2.copy()
    if a <= eps:
        s = 0.0
        t = np.clip(f / e, 0.0, 1.0)
    else:
        c = float(np.dot(d1, r))
        if e <= eps:
            t = 0.0
            s = np.clip(-c / a, 0.0, 1.0)
        else:
            b = float(np.dot(d1, d2))
            den = a * e - b * b
            if abs(den) > 1e-30:
                s = np.clip((b * f - c * e) / den, 0.0, 1.0)
            else:
                s = 0.0
            t = (b * s + f) / e
            if t < 0.0:
                t = 0.0
                s = np.clip(-c / a, 0.0, 1.0)
            elif t > 1.0:
                t = 1.0
                s = np.clip((b - c) / a, 0.0, 1.0)
    return p1 + s * d1, p2 + t * d2


def proper_or_touching_segment_intersection(a, b, c, d, tol=1e-14):
    """包含端点接触的严格二维线段相交检测。"""
    def orient(p, q, r):
        # 修正后的二维叉积：第二项必须使用 r[0]，不能重复 c[1]-a[1]。
        return (q[0] - p[0]) * (r[1] - p[1]) - (q[1] - p[1]) * (r[0] - p[0])

    def on_segment(p, q, r):
        return (
            min(p[0], r[0]) - tol <= q[0] <= max(p[0], r[0]) + tol
            and min(p[1], r[1]) - tol <= q[1] <= max(p[1], r[1]) + tol
        )

    o1, o2 = orient(a, b, c), orient(a, b, d)
    o3, o4 = orient(c, d, a), orient(c, d, b)

    if ((o1 > tol and o2 < -tol) or (o1 < -tol and o2 > tol)) and \
       ((o3 > tol and o4 < -tol) or (o3 < -tol and o4 > tol)):
        return True
    if abs(o1) <= tol and on_segment(a, c, b):
        return True
    if abs(o2) <= tol and on_segment(a, d, b):
        return True
    if abs(o3) <= tol and on_segment(c, a, d):
        return True
    if abs(o4) <= tol and on_segment(c, b, d):
        return True
    return False


def segment_distance(a, b, c, d):
    if proper_or_touching_segment_intersection(a, b, c, d):
        return 0.0
    p, q = closest_points_segments(a, b, c, d)
    return float(np.linalg.norm(p - q))


def minimum_image_periodic_y(dy, Ly):
    return dy - Ly * np.round(dy / Ly)


def wrap_y(y, Ly):
    return np.mod(y, Ly)


