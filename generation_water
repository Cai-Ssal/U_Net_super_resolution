@dataclass
# GPU 5-min optimized: preserve 12000 physical steps while reducing expensive updates.
class Params:
    # ---------- 水/空气界面：有效液相参数 ----------
    rho: float = 997.0
    mu: float = 8.90e-4
    sigma0: float = 7.20e-2
    dsigma_dT: float = -1.50e-4
    beta_T: float = 2.07e-4
    kappa_T: float = 1.43e-7
    T0: float = 298.15
    T_hot: float = 299.15
    T_cold: float = 298.15
    gravity: float = 9.81

    # 有效界面水动力厚度
    interface_depth: float = 5.0e-5

    # ---------- 计算域 ----------
    Lx: float = 1.0e-3
    Ly: float = 1.0e-3
    nx: int = 64
    ny: int = 64
    output_px: int = 512
    render_px: int = 1024  # 先以 1024x1024 超采样渲染，再裁剪最终压缩区并缩放到 512x512

    # ---------- 时间 ----------
    dt: float = 2.0e-5
    n_steps: int = 12000
    save_every: int = 100

    # ---------- 双挡板 ----------
    barrier_speed: float = 7.0e-4
    initial_gap: float = 8.0e-4
    final_gap: float = 2.8e-4
    barrier_width: float = 2.0e-5
    barrier_penalty_rate: float = 3.0e4

    # ---------- 温度 ----------
    # 约化二维模型中，重力投影到界面平面。
    buoyancy_angle_deg: float = 90.0
    temperature_relaxation: float = 2.0e-4
    thermal_gradient_strength: float = 1.0

    # ---------- CNT ----------
    # 每次运行随机生成 100~150 根 CNT（含 100 和 150）
    n_rods_min: int = 200
    n_rods_max: int = 250
    n_rods: int = 125  # 运行时会被随机值覆盖，仅作为默认值
    rod_length_min: float = 1.8e-5
    rod_length_max: float = 4.0e-5
    rod_diameter: float = 1.0e-9
    initial_clearance: float = 2.0e-6
    contact_clearance: float = 1.5e-9

    # ---------- CNT 水动力 ----------
    drag_log_floor: float = 3.0
    drag_coupling_scale: float = 1.0
    rotational_drag_scale: float = 1.0

    # ---------- CNT-CNT 有效相互作用（本版本关闭） ----------
    repulsion_strength: float = 4.0e-19
    attraction_strength: float = 1.5e-19
    alignment_strength: float = 2.0e-19
    interaction_cutoff: float = 7.0e-6
    repulsion_length: float = 1.0e-6
    attraction_length: float = 4.0e-6
    orient_length: float = 5.0e-6

    # ---------- Brownian ----------
    temperature_cnt: float = 298.15
    brownian_translation_scale: float = 1.0
    brownian_rotation_scale: float = 0.5

    # ---------- 数值安全 ----------
    max_fluid_speed: float = 5.0e-4
    max_cnt_speed: float = 2.0e-4
    max_angular_speed: float = 80.0
    max_force_per_rod: float = 2.0e-12
    interaction_stride: int = 2
    coverage_stride: int = 16

    # ---------- GPU ----------
    # True：有可用 NVIDIA CUDA + CuPy 时启用 GPU；否则自动回退 CPU。
    use_gpu: bool = True
    gpu_device: int = 0

    # ---------- 随机种子 ----------
    seed: int = 20261028

    @property
    def nu(self) -> float:
        return self.mu / self.rho


